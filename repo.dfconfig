{
  "repo": {
    "$comment": "Project identity and enforceable intent for Agent OS; branch protection still requires live GitHub administration.",
    "identity": {
      "owner": "marius-patrik",
      "repo": "agent-os",
      "display_name": "Agent OS",
      "default_branch": "main",
      "development_branch": "development",
      "project_title": "agent-os"
    },
    "license": {
      "spdx": "GPL-3.0",
      "holder": "Patrik Marius",
      "year": "2026"
    },
    "upstream": {
      "repo": "marius-patrik/DarkFactory",
      "ref": "368eb9d75d5d828e7ac17fe590d4dc17b028cebc"
    },
    "protection": {
      "lanes": [
        {
          "branch": "main",
          "required_checks": [
            "main-source",
            "generated-docs"
          ],
          "approvals": 1,
          "enforce_admins": true,
          "strict": true,
          "resolve_conversations": true
        }
      ],
      "$comment": "Required live main protection is separately administered. Release PRs originate only from development."
    },
    "areas": {
      "$comment": "Agent OS documentation and delivery ownership.",
      "$default": "docs",
      "docs": {
        "description": "Agent OS specifications, source instructions, agent skill catalog and project rules",
        "keywords": [
          "docs",
          "readme",
          "architecture",
          "rule",
          "request"
        ]
      },
      "ci": {
        "description": "CI, agent bundle compilation, installation contracts, release and benchmark verification",
        "keywords": [
          "ci",
          "action",
          "release",
          "workflow"
        ]
      }
    },
    "versioning": {
      "mode": "tags",
      "$comment": "Default is Git-tag-based SemVer with no VERSION file. Set mode to file and add VERSION to opt in to automatic PR version bumps."
    },
    "board": {
      "global": "Global",
      "boards": [
        "Global",
        "agent-os"
      ]
    }
  },
  "docs": {},
  "providers": {}
}
